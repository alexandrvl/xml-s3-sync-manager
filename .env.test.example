# Copy to .env.test for Compose TEST / demo (do not commit .env.test).
# docker compose -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test up --build

APP_PROFILE=test
AUTH_TEST_TOKEN=test-token
ENTRA_AUTH_ENABLED=false
APP_CONFIG_FILE=/app/config.test.yaml

# UI on :8080 uses form login (test@local / AUTH_TEST_TOKEN).
# Do not set VITE_TEST_TOKEN here; it is Vite/Playwright only and must not be baked into the image.
