# Empty = in-browser adapter (implements the same contract as openapi.yaml).
# Set to /api/v1 for local Vite dev against the Python API (Vite proxies /api → :8080).
# Docker production images always bake /api/v1 (override with DOCKER_VITE_API_BASE_URL).
VITE_API_BASE_URL=

# Optional default object key shown in the sync form.
VITE_OBJECT_KEY=

# --- S3 / SeaweedFS (backend + compose) ---
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_ACCESS_KEY=seaweedfs-access-key
S3_SECRET_KEY=seaweedfs-secret-key
S3_BUCKET=xml-sync
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
# Enterprise PKI (optional). Leave empty for local HTTP SeaweedFS.
# S3_CA_BUNDLE is a PEM file (root or chain) used to verify the S3 HTTPS server cert.
# S3_CLIENT_CERT / S3_CLIENT_KEY are only needed if the S3 gateway requires mTLS.
S3_CA_BUNDLE=
S3_CLIENT_CERT=
S3_CLIENT_KEY=
# Host access to S3: http://localhost:8333
# If you change access/secret keys, also update docker/seaweedfs/s3.json

# --- Backend ---
# Local Vite UI is :3000; production UI is served by the API on :8080 (same origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
AUTH_DEV_SECRET=dev-only-change-me
DATA_DIR=/data

# TEST profile (local e2e). Loads backend/config.test.yaml and accepts
# Authorization: Bearer test-token. Do not set this in production.
# APP_PROFILE=test
# AUTH_TEST_TOKEN=test-token
# VITE_API_BASE_URL=/api/v1
# Directory of Vite dist/ files. Docker sets /app/static. Locally, backend/static or frontend/dist is auto-detected.
STATIC_DIR=

# --- Microsoft Entra ID ---
# Set true after registering an app in Azure (SPA redirect + API audience).
ENTRA_AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=
ENTRA_REDIRECT_URI=http://localhost:3000
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
# API permission scope the SPA requests (expose this on the API app registration).
# Example: api://YOUR_API_CLIENT_ID/access_as_user openid profile email
ENTRA_SCOPES=openid profile email
# Access token audience (Application ID URI or API client id). Defaults to ENTRA_CLIENT_ID.
ENTRA_API_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_ADMIN_ROLES=Administrator,Admin
ENTRA_EDITOR_ROLES=Content Editor,Editor
ENTRA_VIEWER_ROLES=Viewer

# UI build-time Entra values (optional; runtime GET /auth/config is preferred when API is set).
VITE_ENTRA_ENABLED=false
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_REDIRECT_URI=http://localhost:3000
VITE_ENTRA_SCOPES=
